{
  "mcpServers": {
    "indesign": {
      "command": "npx",
      "args": ["-y", "adobe-mcp-indesign"],
      "env": {
        "INDESIGN_BACKEND": "uxp",
        "UXP_BRIDGE_URL": "http://127.0.0.1:3000",
        "BRIDGE_TOKEN": "replace-with-the-token-the-bridge-was-started-with"
      }
    }
  }
}
