{
  "name": "adobe-mcp-suite",
  "version": "0.1.7",
  "description": "One MCP server for Adobe InDesign and Illustrator together, with tools that work across them",
  "mcpName": "io.github.zachshallbetter/adobe-mcp-suite",
  "type": "module",
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "adobe-mcp-suite": "src/index.js"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "adobe",
    "indesign",
    "illustrator",
    "design-automation",
    "extendscript"
  ],
  "author": "Zach Shallbetter",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachshallbetter/adobe-mcp.git",
    "directory": "packages/suite"
  },
  "bugs": {
    "url": "https://github.com/zachshallbetter/adobe-mcp/issues"
  },
  "homepage": "https://github.com/zachshallbetter/adobe-mcp/tree/main/packages/suite#readme",
  "dependencies": {
    "adobe-mcp-core": "0.2.0",
    "adobe-mcp-indesign": "2.5.0",
    "adobe-mcp-illustrator": "0.9.0",
    "adobe-mcp-photoshop": "0.1.0",
    "adobe-mcp-aftereffects": "0.1.0",
    "adobe-mcp-premiere": "0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "types-for-adobe": "^7.2.6"
  }
}
