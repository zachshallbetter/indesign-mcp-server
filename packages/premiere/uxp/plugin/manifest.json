{
  "manifestVersion": 5,
  "id": "io.github.zachshallbetter.adobe-mcp-premiere",
  "name": "MCP Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridgePanel",
      "label": {
        "default": "MCP Bridge"
      },
      "minimumSize": { "width": 230, "height": 160 },
      "preferredDockedSize": { "width": 260, "height": 200 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "allowCodeGenerationFromStrings": true
  }
}
