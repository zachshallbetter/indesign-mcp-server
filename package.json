{
  "name": "adobe-mcp",
  "private": true,
  "description": "MCP servers for Adobe applications: one package per app, and a suite that combines them",
  "workspaces": [
    "packages/core",
    "packages/indesign",
    "packages/illustrator",
    "packages/suite"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
